{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acai-da-mary",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules",
    "enable_nodejs_sqlite_module"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz", "/baixar-apk"]
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.apk"], "fallthrough": true }
  ],
  "vars": {
    "APP_USER": "CASADOACAI",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "TURSO_DATABASE_URL": "libsql://saidas-mary-casadoacai.aws-eu-west-1.turso.io"
  },
  "observability": { "enabled": true }
}
