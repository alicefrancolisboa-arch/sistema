{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aloha-casa-do-acai",
  "main": "worker.py",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "vars": {
    "APP_USER": "CASADOACAI",
    "STORAGE_DRIVER": "turso"
  },
  "observability": { "enabled": true }
}
